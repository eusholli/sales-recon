# Sales-recon environment variables. Copy to .env and fill in real values.
# .env is gitignored.

# ── OpenClaw gateway ────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=50045
OPENCLAW_BRIDGE_PORT=
OPENCLAW_CONFIG_DIR=./openclaw-data
OPENCLAW_WORKSPACE_DIR=./openclaw-data/workspace
OPENCLAW_HOME_VOLUME=
OPENCLAW_IMAGE=
OPENCLAW_DOCKER_APT_PACKAGES=
OPENCLAW_EXTRA_MOUNTS=

# ── gbrain (Postgres-backed knowledge brain) ────────────────────────────────
# Used by the gbrain MCP server inside sales-recon-openclaw.
# DATABASE_URL is constructed in docker-compose from GBRAIN_POSTGRES_PASSWORD.
GBRAIN_POSTGRES_PASSWORD=
OPENAI_API_KEY=

# ── ws-proxy / Clerk auth ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
WS_PROXY_CLERK_SECRET_KEYS=
WEBAPP_URL=http://host.docker.internal:3000

# ── Cron / event-planner integration ────────────────────────────────────────
CRON_EVENT_PLANNER_DNS=
CRON_SECRET_KEY=

# ── AI provider keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# ── Web search / scraping ───────────────────────────────────────────────────
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
GPTZERO_API_KEY=
