# ============================================
# OpenClaw 4.2 Config Rules (Mapped to openclaw-data/)
# ============================================

# --- CREDENTIALS & SECRETS (CRITICAL) ---
openclaw-data/identity/
openclaw-data/credentials/
openclaw-data/devices/
openclaw-data/agents/*/agent/auth-profiles.json
openclaw-data/agents/*/agent/auth.json
# Runtime state — records the agent's lastUsedCommand which may include
# Bearer tokens etc. Must never be tracked.
openclaw-data/exec-approvals.json

# --- RUNTIME & EPHEMERAL DATA ---
openclaw-data/memory/
openclaw-data/logs/
openclaw-data/completions/
openclaw-data/cron/
openclaw-data/subagents/
openclaw-data/canvas/
openclaw-data/update-check.json

# --- SESSION DATA ---
openclaw-data/agents/*/sessions/

# --- BACKUP FILES ---
*.bak
*.bak.*

# --- WORKSPACE RUNTIME ---
openclaw-data/workspace/.openclaw/
openclaw-data/workspace/.pi/
openclaw-data/workspace/device.identity.json/
openclaw-data/workspace-tavily/.openclaw/
openclaw-data/workspace-tavily/.pi/
openclaw-data/workspace-tavily/device.identity.json/

# --- WORKSPACE MEMORY / RESEARCH ARTIFACTS ---
openclaw-data/workspace/memory/
openclaw-data/workspace-tavily/memory/
openclaw-data/workspace-long-context/memory/

# --- INTEL DISPATCHER RUNTIME OUTPUT ---
openclaw-data/workspace/intel-jobs/

# Explicitly ignored research artifacts
openclaw-data/workspace/AT&T_Sales_Intelligence_2026.md
openclaw-data/workspace/Krishna_Rao.md

# --- DEVICE IDENTITY ---
openclaw-data/device.identity.json/

# --- ADDITIONAL OVERRIDES ---

# --- SQLite Additions ---
*.sqlite-shm

# --- Temp Files ---
*.tmp

# --- Additional Auth State ---
openclaw-data/agents/*/agent/auth-state.json

# --- Ensure deep .openclaw paths are ignored ---
openclaw-data/workspace-*/.openclaw/

# --- Agent Codex State (contains auth, SQLite DBs, memory) ---
openclaw-data/agents/*/agent/codex-home/

# --- NPM Plugin Dependencies ---
openclaw-data/npm/

# --- Last-Good Config Backups ---
openclaw-data/*.last-good

# --- Plugin Skill Symlinks ---
openclaw-data/plugin-skills/

# --- Plugin Installation Registry ---
openclaw-data/plugins/